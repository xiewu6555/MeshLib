{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-win-vs2022",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "USE_MANUAL_OPENCASCADE": "ON",
        "MESHLIB_BUILD_MRCUDA": "OFF",
        "MESHLIB_PYTHON_SUPPORT": "OFF",
        "MESHLIB_BUILD_PYTHON_MODULES": "OFF",

        "MESHLIB_BUILD_MRVIEWER": "ON",
        "MESHLIB_BUILD_MESHVIEWER": "ON",
        "MESHLIB_BUILD_VOXELS": "ON",

        "MRIOEXTRAS_NO_STEP": "OFF",
        "MRIOEXTRAS_NO_3MF": "ON",
        "MRIOEXTRAS_NO_E57": "ON",
        "MRIOEXTRAS_NO_JPEG": "ON",
        "MRIOEXTRAS_NO_LAS": "ON",
        "MRIOEXTRAS_NO_PDF": "ON"
      }
    },
    {
      "name": "viewer-debug",
      "displayName": "MeshViewer (Debug) - VS2022 x64",
      "description": "Debug build for MeshViewer with CUDA/Python disabled and lean IO formats",
      "inherits": "base-win-vs2022"
    },
    {
      "name": "viewer-release",
      "displayName": "MeshViewer (Release) - VS2022 x64",
      "description": "Release build for MeshViewer with CUDA/Python disabled and lean IO formats",
      "inherits": "base-win-vs2022"
    },
    {
      "name": "viewer-full-release",
      "displayName": "MeshViewer (Release, Full IO) - VS2022 x64",
      "description": "Release build with common IO features enabled (may require full vcpkg cache)",
      "inherits": "base-win-vs2022",
      "cacheVariables": {
        "MRIOEXTRAS_NO_3MF": "OFF",
        "MRIOEXTRAS_NO_E57": "OFF",
        "MRIOEXTRAS_NO_JPEG": "OFF",
        "MRIOEXTRAS_NO_LAS": "OFF",
        "MRIOEXTRAS_NO_PDF": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "viewer-debug-build",
      "configurePreset": "viewer-debug",
      "configuration": "Debug",
      "targets": [
        "MeshViewer"
      ],
      "jobs": 8
    },
    {
      "name": "viewer-release-build",
      "configurePreset": "viewer-release",
      "configuration": "Release",
      "targets": [
        "MeshViewer"
      ],
      "jobs": 8
    },
    {
      "name": "viewer-full-release-build",
      "configurePreset": "viewer-full-release",
      "configuration": "Release",
      "targets": [
        "MeshViewer"
      ],
      "jobs": 8
    }
  ]
}

